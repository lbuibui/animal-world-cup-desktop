# ===== Public online play (跨公网联机) =====
# Two build-time env vars make the desktop app use a public relay instead of
# the local one. Steps:
#   1. Deploy the relay:  pnpm deploy:online
#      (needs a Cloudflare account; wrangler prints your workers.dev URL)
#   2. Set both vars below, then rebuild + repackage:  pnpm desktop:build
#      (env vars are inlined at build time — a rebuild is REQUIRED)

# Relay URL from step 1, e.g. https://animal-cup-online.<your-subdomain>.workers.dev
# Without it, online play uses the local relay (LAN-only, same Wi-Fi).
NEXT_PUBLIC_ONLINE_SERVICE_URL=https://animal-cup-online.example.workers.dev

# Public URL of the app, used in invite links (OnlineRoomClient).
# Required for cross-network play: without it invite links point at
# localhost / the host's LAN IP, which remote friends cannot open.
# Use a public deployment of the app (e.g. https://animal-cup.your-domain.com)
# or any URL that serves the same app build.
NEXT_PUBLIC_APP_URL=https://animal-cup.example.com
